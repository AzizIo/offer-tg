# Required. Generate a fresh token with @BotFather.
BOT_TOKEN=
# Required numeric Telegram user ID of the product owner.
OWNER_ID=
# Optional comma-separated Telegram user IDs with admin rights.
ADMIN_IDS=

# Optional public channel username, without @. Leave empty to disable the gate.
SUB_CHANNEL=easynftch

DB_PATH=./data/offers.sqlite3
DEFAULT_OFFER_TTL_HOURS=6

# Monthly Telegram Stars prices (XTR).
NORMAL_PRICE_STARS=200
VIP_PRICE_STARS=400
SUBSCRIPTION_DAYS=30

# Offer limits per subscription.
NORMAL_MAX_ACTIVE_OFFERS=5
NORMAL_DAILY_OFFERS=20
VIP_MAX_ACTIVE_OFFERS=50
VIP_DAILY_OFFERS=200
