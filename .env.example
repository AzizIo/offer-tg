# Generate a NEW token with @BotFather. Do not reuse the leaked token.
BOT_TOKEN=

# Required numeric Telegram user ID of the product owner.
OWNER_ID=
OWNER_USERNAME=RuslanArasov

# Optional comma-separated numeric Telegram IDs of trusted admins.
ADMIN_IDS=

# Public channel username without @. Leave empty to disable the channel gate.
SUB_CHANNEL=easynftch

DB_PATH=./data/offers.sqlite3
DEFAULT_OFFER_TTL_HOURS=6
LOG_LEVEL=INFO

# Subscription prices are informational until Stars checkout is implemented.
NORMAL_PRICE_STARS=200
VIP_PRICE_STARS=400

# Daily offer quotas. VIP has a higher quota.
NORMAL_DAILY_OFFERS=20
VIP_DAILY_OFFERS=200
